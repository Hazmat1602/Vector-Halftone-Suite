#include "resource.h"
#include "VectorHalftoneEffectID.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "winnt.h"
#include "winres.h"
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
#ifdef _WIN32
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_AUS
#pragma code_page(1252)
#endif

// Keep version metadata local to the plug-in rather than depending on the
// SDK's historical common/win/verinfo.rc helper, which is not present in
// current Illustrator SDK layouts.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,3,0,0
 PRODUCTVERSION 0,3,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0C0904B0"
        BEGIN
            VALUE "CompanyName", "Vector Halftone\0"
            VALUE "FileDescription", "Vector Halftone Illustrator Live Effect\0"
            VALUE "FileVersion", "0.3.0.0\0"
            VALUE "InternalName", "VectorHalftoneEffect\0"
            VALUE "OriginalFilename", "VectorHalftoneEffect.aip\0"
            VALUE "ProductName", "Vector Halftone Live Effect\0"
            VALUE "ProductVersion", "0.3.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0c09, 1200
    END
END

// PiPL is generated by the pre-build step at the project root.
plugin pipl "plugin.pipl"

#endif
